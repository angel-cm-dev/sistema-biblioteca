{
  "name": "sistema-biblioteca-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Interfaz web del Sistema de Biblioteca (React + Vite + TypeScript + Tailwind)",
  "author": "Angel Castañeda Meza",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
