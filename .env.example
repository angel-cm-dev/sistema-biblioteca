# Copie este archivo como .env (raíz para docker compose, o backend/.env para desarrollo local).
# Todos los valores son de EJEMPLO: no use estos secretos en producción.

# Base de datos
# SQLite local:  sqlite:///./biblioteca.db
# SQLite Docker: sqlite:////app/data/biblioteca.db
# PostgreSQL:    postgresql+psycopg://biblioteca:biblioteca@db:5432/biblioteca
DATABASE_URL=sqlite:///./biblioteca.db

# Seguridad (genere uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambia-este-secreto-en-produccion-minimo-32-caracteres
JWT_EXPIRES_MINUTES=60
BCRYPT_ROUNDS=12

# Reglas de negocio
FINE_PER_DAY=1.00
DEBT_BLOCK_THRESHOLD=10.00
RESERVATION_HOLD_DAYS=3

# Otros
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
SEED_ON_STARTUP=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend (opcional): URL de la API si no se usa el proxy /api
# VITE_API_URL=http://localhost:8000/api/v1
